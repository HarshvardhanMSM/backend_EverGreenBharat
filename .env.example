# ==============================================================================
# ENVIRONMENT & OPTIMIZATION CONFIGURATION
# ==============================================================================
# In production, set NODE_ENV=production to automatically purge dummy data
# and initialize only 1 Super Admin and 1 Main Staff account.
NODE_ENV=development
PORT=3000

# Production Admin & Staff Credentials
SUPERADMIN_EMAIL=admin@stream.com
SUPERADMIN_PASSWORD=YourSecurePassword123!
STAFF_EMAIL=staff@nursery.com
STAFF_PASSWORD=YourSecureStaffPassword123!
STAFF_ROLE=ADMIN

# Dynamic CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_DATABASE=nursery_db
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_SSL=false

# Redis Cache & Sessions (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets
JWT_SECRET=super-secret-jwt-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-key
JWT_REFRESH_EXPIRES_IN=7d

# OTP Configuration
OTP_MOCK_ENABLED=true
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# Media Uploads
UPLOADS_DIR=uploads
