# ==============================================================================
# ENVIRONMENT & OPTIMIZATION CONFIGURATION
# ==============================================================================
# When NODE_ENV=production:
# 1. All dummy/demo data (dummy vendors, customers, products, orders, inquiries) is removed.
# 2. ONLY 1 Super Admin and 1 Main Staff account are inserted/maintained.
# 3. HTTP Compression, DB connection pooling, and security hardening are active.
NODE_ENV=production
PORT=3000

# Production Admin & Staff Credentials (Auto-inserted when NODE_ENV=production or db:clean-demo)
SUPERADMIN_EMAIL=admin@stream.com
SUPERADMIN_PASSWORD=Admin@123456
STAFF_EMAIL=staff@nursery.com
STAFF_PASSWORD=Staff@123456
STAFF_ROLE=ADMIN

# Dynamic CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# PostgreSQL Connection Pool Tuning
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_SSL=false

# DB_HOST=postgres
# DB_PORT=5433
# DB_USERNAME=postgres
# DB_PASSWORD=your_password
# DB_DATABASE=livestream_db

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_DATABASE=nursery_db

# REDIS_HOST=redis
# REDIS_PORT=6379

REDIS_HOST=localhost
REDIS_PORT=6380

# OTP (development mock provider: logs codes, accepts fixed code 123456 when enabled)
OTP_MOCK_ENABLED=true
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# Google login (leave empty to skip client-id audience check)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo

# Local file uploads (avatars, covers)
UPLOADS_DIR=uploads